{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "git": {
    "deploymentEnabled": {
      "development": false,
      "main": false
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/build/client",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/docs/nodes",
      "destination": "/docs/nodes/index.html"
    },
    {
      "source": "/docs/recipes",
      "destination": "/docs/recipes/index.html"
    },
    {
      "source": "/docs/reference",
      "destination": "/docs/reference/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/__spa-fallback.html"
    }
  ]
}
