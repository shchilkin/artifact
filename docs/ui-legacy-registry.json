  "migrationBatches": [
    {
      "id": "artifact-foundation-adapters",
      "ownerIssue": 181,
      "replacementBoundary": "Use @artifact/ui primitives directly; keep Artifact appearance in the Artifact Product Theme and composed product patterns."
    },
    {
      "id": "artifact-feature-entrypoints",
      "ownerIssue": 181,
      "replacementBoundary": "Import LayerPanel and NodeCanvas from their feature-folder public entrypoints."
    },
    {
      "id": "artifact-inspector-selectors",
      "ownerIssue": 181,
      "replacementBoundary": "Use source-owned artifact-inspector-* anatomy from apps/web/app/components/inspector-system."
    },
    {
      "id": "artifact-semantic-tokens",
      "ownerIssue": 181,
      "replacementBoundary": "Use --surface-*, --line-*, --text-*, --accent-*, --state-*, and --font-* semantic tokens."
    },
    {
      "id": "backoffice-zero-baseline",
      "ownerIssue": 180,
      "replacementBoundary": "Keep Foundation primitives in @artifact/ui and Backoffice compositions in components/backoffice-ui; do not recreate Ui.tsx."
    }
  ],
  "legacyContracts": [
    {
      "id": "artifact-action-command-adapter-imports",
      "kind": "primitive-import",
      "batch": "artifact-foundation-adapters",
      "replacement": "@artifact/ui Button and ButtonLink",
      "scan": {
        "roots": ["apps/web/app"],
        "extensions": ["ts", "tsx"],
        "pattern": "(?:ui/ActionButton|['\"]\\./ActionButton['\"])"
