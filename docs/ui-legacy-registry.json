      "scan": {
        "roots": ["apps/web/app"],
        "extensions": ["ts", "tsx"],
        "pattern": "components/LayerPanel"
      },
      "allowedReferences": {}
    },
    {
      "id": "artifact-node-canvas-alias-imports",
      "kind": "alias-import",
      "batch": "artifact-feature-entrypoints",
      "replacement": "apps/web/app/components/node-canvas/index.ts",
      "scan": {
        "roots": ["apps/web/app"],
        "extensions": ["ts", "tsx"],
        "pattern": "components/NodeCanvas"
      },
      "allowedReferences": {}
    },
    {
      "id": "artifact-node-inspector-selectors",
      "kind": "css-selector",
      "batch": "artifact-inspector-selectors",
      "replacement": "artifact-inspector-* source-owned inspector anatomy",
      "scan": {
        "roots": ["apps/web/app"],
        "extensions": ["css", "ts", "tsx"],
        "pattern": "node-inspector-[A-Za-z0-9_-]+"
      },
      "allowedReferences": {}
    },
    {
      "id": "artifact-sidebar-section-selectors",
      "kind": "css-selector",
      "batch": "artifact-inspector-selectors",
      "replacement": "InspectorSection slots and artifact-inspector-section__* selectors",
      "scan": {
        "roots": ["apps/web/app"],
        "extensions": ["css", "ts", "tsx"],
        "pattern": "sidebar-section[A-Za-z0-9_-]*"
      },
      "allowedReferences": {}
    },
    {
      "id": "artifact-short-token-aliases",
      "kind": "css-token-alias",
      "batch": "artifact-semantic-tokens",
      "replacement": "Artifact semantic token families documented in docs/style-guide.md",
      "scan": {
        "roots": ["apps/web/app"],
        "extensions": ["css", "ts", "tsx"],
        "pattern": "var\\(--(?:app-bg|workspace-bg|panel-bg|panel-raised|surface-bg|surface-hover|surface-input|surface-selected|border-muted|border|border-strong|text|text-dim|bg|sidebar-bg|sidebar-raised|accent|accent-dim|danger|success|warning|mono)(?=\\s*[,)])"
      },
      "allowedReferences": {}
    },
    {
      "id": "backoffice-retired-ui-module",
      "kind": "forbidden-import",
      "batch": "backoffice-zero-baseline",
      "replacement": "@artifact/ui plus apps/backoffice/app/components/backoffice-ui",
      "scan": {
        "roots": ["apps/backoffice/app"],
        "extensions": ["ts", "tsx"],
        "pattern": "(?:components/Ui|from\\s+['\"][^'\"]*Ui['\"])"
      },
      "allowedReferences": {}
    }
  ],
