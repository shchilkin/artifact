{
  "name": "album-cover-utils",
  "private": true,
  "version": "0.49.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/api",
    "apps/backoffice",
    "apps/web",
    "packages/runtime",
    "packages/shared",
    "packages/ui"
  ],
  "scripts": {
    "favicon": "npm --workspace @artifact/web run favicon",
    "fallow": "fallow --format json --quiet --explain",
    "fallow:audit": "fallow audit --format json --quiet --explain",
    "fallow:dead-code": "fallow dead-code --format json --quiet --explain",
    "fallow:dupes": "fallow dupes --format json --quiet --explain",
    "fallow:health": "fallow health --format json --quiet --explain --score --top 20",
    "dev": "npm --workspace @artifact/web run dev",
    "dev:backoffice": "npm --workspace @artifact/backoffice run dev",
    "dev:api": "npm --workspace @artifact/api run dev",
    "dev:infra": "docker compose -f docker-compose.local.yml up -d postgres redis",
    "dev:infra:down": "docker compose -f docker-compose.local.yml down",
    "dev:local-ai": "deno task dev:local-ai",
    "dev:web": "npm --workspace @artifact/web run dev",
    "dev:worker": "npm --workspace @artifact/api run worker:dev",
    "build": "npm --workspace @artifact/web run build && npm --workspace @artifact/backoffice run build",
    "build:backoffice": "npm --workspace @artifact/backoffice run build",
    "build:api": "npm --workspace @artifact/api run build",
    "build:ci": "npm --workspace @artifact/web run build:ci",
    "build:shared": "npm --workspace @artifact/shared run build",
    "check": "npm run format:check && npm run lint && npm run quality:ui-legacy-registry && npm run typecheck:shared && npm run typecheck:runtime && npm run typecheck:ui && npm run typecheck && npm run typecheck:api && npm run typecheck:backoffice && npm run test:deploy && npm run test:loading && npm run test:editor-ux && npm run test:ui-legacy-registry && npm run test:ui && npm run test:runtime && npm test && npm run test:api && npm run test:backoffice",
    "check:backoffice": "npm --workspace @artifact/backoffice run check",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "eslint .",
    "prepare": "husky",
    "preview": "npm --workspace @artifact/web run preview",
    "quality:ui-legacy-registry": "node scripts/quality/ui-legacy-registry.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "turbo:build": "turbo run build --filter=@artifact/shared --filter=@artifact/api --filter=@artifact/web",
    "turbo:check": "turbo run build typecheck test --filter=@artifact/shared --filter=@artifact/api --filter=@artifact/web",
    "turbo:dev": "turbo run dev --filter=@artifact/api --filter=@artifact/web",
    "turbo:typecheck": "turbo run typecheck --filter=@artifact/shared --filter=@artifact/api --filter=@artifact/web",
    "typecheck": "npm --workspace @artifact/web run typecheck",
    "typecheck:backoffice": "npm --workspace @artifact/backoffice run typecheck",
    "typecheck:api": "npm --workspace @artifact/api run typecheck",
    "typecheck:shared": "npm --workspace @artifact/shared run typecheck",
    "typecheck:ui": "npm --workspace @artifact/ui run typecheck",
    "test": "npm --workspace @artifact/web run test",
    "test:ui": "npm --workspace @artifact/ui run test",
    "test:backoffice": "npm --workspace @artifact/backoffice run test",
    "test:api": "npm --workspace @artifact/api run test",
    "test:coverage": "npm run test:coverage:web && npm run test:coverage:api",
    "test:coverage:api": "npm --workspace @artifact/api run test:coverage",
    "test:coverage:web": "npm --workspace @artifact/web run test:coverage",
    "test:deploy": "node --test scripts/deploy/*.test.mjs",
    "test:ui-legacy-registry": "node --test scripts/quality/ui-legacy-registry.test.mjs",
    "test:browser": "npm --workspace @artifact/web run test:browser --",
    "test:browser:backoffice": "npm --workspace @artifact/backoffice run test:browser --",
    "test:browser:chromium": "npm --workspace @artifact/web run test:browser:chromium --",
    "test:browser:firefox": "npm --workspace @artifact/web run test:browser:firefox --",
    "test:browser:webkit": "npm --workspace @artifact/web run test:browser:webkit --",
    "test:e2e:backoffice:run": "npm --workspace @artifact/backoffice run test:browser --",
    "test:browser:mobile": "npm --workspace @artifact/web run test:browser:mobile --",
    "test:browser:release": "node scripts/run-browser-release.mjs",
    "test:browser:ui-conformance": "npm run test:browser -- --project=chromium --project=firefox --project=webkit ui-foundation.spec.ts && npm run test:browser:backoffice -- style-guide.spec.ts",
    "test:browser:headed": "npm --workspace @artifact/web run test:browser -- --headed",
    "test:browser:install": "playwright install --with-deps chromium firefox webkit",
    "perf:node-editor": "node tests/performance/node-editor.benchmark.mjs",
    "test:loading": "node --test scripts/loading/*.test.mjs",
    "loading:gate": "node scripts/loading/gate.mjs",
    "test:editor-ux": "node --test scripts/editor-ux/*.test.mjs",
    "ux:gate": "node scripts/editor-ux/gate.mjs",
    "build:runtime": "npm --workspace @artifact/runtime run build",
    "typecheck:runtime": "npm --workspace @artifact/runtime run typecheck",
    "test:runtime": "npm --workspace @artifact/runtime run test",
    "test:runtime:harness": "npm --workspace @artifact/shared run build && playwright test -c playwright.config.ts runtime-chain.spec.ts runtime-harness.spec.ts runtime-catalogue.spec.ts runtime-live-package.spec.ts"
  },
  "dependencies": {
    "@react-router/node": "^7.18.4",
    "@xstate/react": "^6.1.0",
    "@xyflow/react": "^12.10.2",
    "framer-motion": "^12.38.0",
    "pixi.js": "^7.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.18.4",
    "three": "^0.184.0",
    "xstate": "^5.31.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.0",
    "@playwright/test": "^1.60.0",
    "@react-router/dev": "^7.18.4",
    "@react-router/serve": "^7.18.4",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fallow": "^2.88.3",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "tailwindcss": "^4.2.4",
    "turbo": "^2.8.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-tsconfig-paths": "^1.4.1",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": [
      "biome check --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
